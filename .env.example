# Copy this file to .env and adjust if needed.
# No paid API keys are required.

# Selected Bengali Wikisource book
BOOK_TITLE=রাজর্ষি
BOOK_URL=https://bn.wikisource.org/wiki/রাজর্ষি

# Local Hugging Face embedding model (Bengali-capable)
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Local Ollama LLM (no cloud API)
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Retrieval
TOP_K=5
RETRIEVAL_THRESHOLD=0.25
