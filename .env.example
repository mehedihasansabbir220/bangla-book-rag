# Copy this file to .env and adjust if needed.
# No paid API keys are required.

# Selected Bengali Wikisource book (1961 edition; the short title URL is missing)
BOOK_TITLE=রাজর্ষি
BOOK_URL=https://bn.wikisource.org/wiki/রাজর্ষি_(১৯৬১)

# Local Hugging Face embedding model (Bengali-capable, runs on CPU)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu

# Local Ollama LLM (no cloud API)
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

# Chunking (word counts, not characters)
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Retrieval (FAISS L2 distance: lower is closer)
# TOP_K = neighbours for search/evaluation. GENERATION_K = chunks sent to the LLM.
# 0.40 was measured on the 10 test questions (in-book ≈ 0.22–0.30, out-of-book ≈ 0.48).
TOP_K=5
GENERATION_K=3
RETRIEVAL_THRESHOLD=0.40
